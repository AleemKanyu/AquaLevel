<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Duolingo Style Palette -->
    <color name="duo_green">#58CC02</color>
