<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="120dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/duo_text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"/>

            <!-- Profile Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="32dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/duo_blue_light">
                        
                    <com.example.aqualevel.WaveView
                        android:id="@+id/profileWaveView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.9"/>
                        
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/user"
                        android:layout_gravity="center"
                        app:tint="@color/duo_blue"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="DISPLAY NAME"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeColor="@color/duo_blue"
                    app:hintTextColor="@color/duo_blue"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-bold"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Preferences Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREFERENCES"
                android:textColor="@color/duo_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/duo_border"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Haptic Feedback -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Haptic Feedback"
                                android:textColor="@color/duo_text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-bold"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchVibration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Notifications -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Smart Alerts"
                                android:textColor="@color/duo_text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-bold"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Gyroscope Water -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gyroscope Water"
                                android:textColor="@color/duo_text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Water reacts to phone tilt"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchGyroWater"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Disable Animation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disable Tank Animation"
                                android:textColor="@color/duo_text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reduces battery usage"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDisableAnimation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Performance Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Performance Mode"
                                android:textColor="@color/duo_text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Optimized for low-end devices"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchPerformanceMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>


                    <!-- Unit Selection -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Volume Unit"
                            android:textColor="@color/duo_text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"
                            android:layout_marginBottom="12dp"/>
                        
                        <RadioGroup
                            android:id="@+id/radioGroupUnits"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_toggle_group"
                            android:padding="4dp">
                            <RadioButton
                                android:id="@+id/radioLiters"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="LITERS"
                                android:gravity="center"
                                android:button="@null"
                                android:background="@drawable/selector_toggle_btn"
                                android:textColor="@color/selector_toggle_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-black"/>
                            <RadioButton
                                android:id="@+id/radioGallons"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="GALLONS"
                                android:gravity="center"
                                android:button="@null"
                                android:background="@drawable/selector_toggle_btn"
                                android:textColor="@color/selector_toggle_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginStart="4dp"/>
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WIDGET SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIDGET CUSTOMIZATION"
                android:textColor="@color/duo_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/duo_border"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Widget Theme Selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Widget Theme"
                            android:textColor="@color/duo_text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"
                            android:layout_marginBottom="12dp"/>
                        
                        <RadioGroup
                            android:id="@+id/radioGroupWidgetTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_toggle_group"
                            android:padding="4dp">
                            <RadioButton
                                android:id="@+id/radioWidgetLight"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="LIGHT"
                                android:gravity="center"
                                android:button="@null"
                                android:background="@drawable/selector_toggle_btn"
                                android:textColor="@color/selector_toggle_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-black"/>
                            <RadioButton
                                android:id="@+id/radioWidgetDark"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="DARK"
                                android:gravity="center"
                                android:button="@null"
                                android:background="@drawable/selector_toggle_btn"
                                android:textColor="@color/selector_toggle_text"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginStart="4dp"/>
                        </RadioGroup>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Show Percentage -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show Percentage"
                            android:textColor="@color/duo_text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchWidgetPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Show Volume -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show Volume"
                            android:textColor="@color/duo_text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchWidgetVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/duo_border_light"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Show Timestamp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show Timestamp"
                            android:textColor="@color/duo_text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"/>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchWidgetTimestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Calibration Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALIBRATION"
                android:textColor="@color/duo_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/duo_border"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_warning_light"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_trend_arrow"
                            app:tint="@color/brand_warning"
                            android:rotation="0"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Advanced Configuration"
                            android:textColor="@color/brand_warning"
                            android:fontFamily="sans-serif-bold"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">
                        
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Full (cm)"
                            app:boxStrokeWidth="2dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editFullDist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:fontFamily="sans-serif-medium"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Empty (cm)"
                            app:boxStrokeWidth="2dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginStart="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editEmptyDist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:fontFamily="sans-serif-medium"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Total Volume (Liters)"
                        app:boxStrokeWidth="2dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="24dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:fontFamily="sans-serif-medium"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low Level Alert"
                        android:textColor="@color/duo_text_secondary"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <SeekBar
                            android:id="@+id/seekbarThreshold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="50"
                            android:progressTint="@color/duo_blue"
                            android:thumbTint="@color/duo_blue"/>
                        <TextView
                            android:id="@+id/textThresholdValue"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:text="30%"
                            android:gravity="end"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/duo_blue"
                            android:textSize="18sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="SAVE CHANGES"
                android:fontFamily="sans-serif-black"
                android:textSize="16sp"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_duo_button"
                android:textColor="@color/white"
                app:backgroundTint="@null"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
