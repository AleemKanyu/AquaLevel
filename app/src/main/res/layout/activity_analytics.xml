<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FA"
    tools:context=".Analytics">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/man" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/welcome"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily=""
                android:gravity="center"
                android:text="@string/welcome"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/user_name"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginEnd="20dp"
            android:elevation="10dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="23dp"
            app:cardUseCompatPadding="true">

            <ImageView
                android:id="@+id/themeIcon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_moon" />
        </FrameLayout>


    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/view2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginTop="70dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/card_press_anim"
                    android:layout_width="wrap_content"
                    android:layout_height="160dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_purple_card"
                    android:elevation="2dp"
                    app:cardCornerRadius="32dp">

                    <LinearLayout
                        android:layout_width="174dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current \nLevel"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="55dp"
                                android:layout_height="20dp">

                            </Space>

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/ic_level_badge">

                                </ImageView>
                            </FrameLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="50dp">

                        </Space>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/percentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="72"
                                android:textColor="@android:color/black"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="%"
                                android:textColor="#5D5D5D"
                                android:textSize="28dp"


                                android:textStyle="bold">

                            </TextView>
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/card_press_anim"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_teal_card"
                    android:elevation="2dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="8dp">

                    <LinearLayout

                        android:layout_width="174dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily \nUsage"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="70dp"
                                android:layout_height="20dp">

                            </Space>

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/ic_usage_badge">

                                </ImageView>
                            </FrameLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="50dp">

                        </Space>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="120"
                                android:textColor="@android:color/black"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="L"
                                android:textColor="#5D5D5D"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/card_press_anim"
                    android:layout_width="wrap_content"
                    android:layout_height="160dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_lime_card"
                    android:elevation="2dp"
                    app:cardCornerRadius="32dp">

                    <LinearLayout
                        android:layout_width="174dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tank \nStatus"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="60dp"
                                android:layout_height="20dp">

                            </Space>

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/ic_status_badge">

                                </ImageView>
                            </FrameLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="50dp">

                        </Space>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Optimal"
                            android:textColor="@android:color/black"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>


                <FrameLayout
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/card_press_anim"
                    android:layout_width="170dp"
                    android:layout_height="160dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_blue_card"
                    android:elevation="2dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="2dp">


                    <LinearLayout
                        android:layout_width="174dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Est. \nTime"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="70dp"
                                android:layout_height="20dp">

                            </Space>

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/ic_refill_badge">

                                </ImageView>
                            </FrameLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="50dp">

                        </Space>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textColor="@android:color/black"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Days"
                                android:textColor="#5D5D5D"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>


            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="20dp"
                android:paddingBottom="30dp"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"

                    android:orientation="vertical"

                    >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="left"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_rounded"
                            android:padding="8dp"
                            android:src="@drawable/ic_chart_bars"
                            app:tint="#A1C9F1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="4dp"
                            android:backgroundTint="@color/black"
                            android:text="Weekly Usage"
                            android:textColor="#000000"
                            android:textSize="24sp"
                            android:textStyle="bold">

                        </TextView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"

                        android:text="Analysis for the current week"
                        android:textColor="#64748B">

                    </TextView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#F0F7FA" />

                                <View
                                    android:id="@+id/mondayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#A1C9F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/monday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="M"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#F0F7FA" />

                                <View
                                    android:id="@+id/tuesdayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#A1C9F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tuesday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="T"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#F0F7FA" />

                                <View
                                    android:id="@+id/wedBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#A1C9F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/wed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="W"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#F0F7FA" />

                                <View
                                    android:id="@+id/thursdayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#A1C9F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/thursday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="T"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#F0F7FA" />

                                <View
                                    android:id="@+id/fridayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#A1C9F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/friday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="F"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#F0F7FA" />

                                <View
                                    android:id="@+id/saturdayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#A1C9F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/saturday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="S"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#F0F7FA" />

                                <View
                                    android:id="@+id/sundayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="#A1C9F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/sunday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="S"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>
<Space
    android:layout_width="match_parent"
    android:layout_height="120dp">

</Space>
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_card"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/homeButton"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/card_press_anim"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="33dp"
        android:elevation="10dp"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/buttonCheck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"

            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="#6B7C93" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/analyticsButton"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/card_press_anim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fab"
        android:elevation="10dp"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/view2"
        app:layout_constraintEnd_toStartOf="@+id/homeButton"
        app:layout_constraintStart_toStartOf="@+id/view2"
        app:layout_constraintTop_toTopOf="@+id/view2"

        >

        <ImageView
            android:id="@+id/analyticsImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/graph_analytics_white"

            android:paddingBottom="10dp"

            />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/settingsButton"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/card_press_anim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="7dp"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/view2"
        app:layout_constraintEnd_toEndOf="@+id/view2"
        app:layout_constraintStart_toEndOf="@+id/homeButton"
        app:layout_constraintTop_toTopOf="@+id/view2">

        <ImageView
            android:id="@+id/settingsImage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/setting"
            android:padding="4dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>