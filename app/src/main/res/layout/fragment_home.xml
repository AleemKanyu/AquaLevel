<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background">

    <ScrollView
        android:id="@+id/scrollBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Notification Permission Card -->
            <LinearLayout
                android:id="@+id/notificationPermissionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_duo_card"
                android:backgroundTint="@color/notification_card_bg"
                android:layout_marginHorizontal="20dp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_sync"
                    app:tint="@color/notification_icon_tint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications Disabled"
                        android:textColor="@color/notification_text_primary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to enable water level alerts"
                        android:textColor="@color/notification_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnEnableNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Enable"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_duo_button"
                    android:backgroundTint="@color/notification_button_bg"
                    android:textColor="@color/notification_button_text"
                    android:fontFamily="sans-serif-black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_duo_card"
                android:layout_marginHorizontal="20dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:layout_gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/tankContainer"
                        android:layout_width="200dp"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_margin="50dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.example.aqualevel.WaveView
                            android:id="@+id/waterLevel"
                            android:layout_width="match_parent"
                            android:layout_height="288dp"
                            android:layout_gravity="bottom"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="0dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp" />

                        <FrameLayout
                            android:id="@+id/glass"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/tank_glass_overlay" />

                        <TextView
                            android:id="@+id/percentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:elevation="5dp"
                            android:shadowColor="#40000000"
                            android:shadowDx="1"
                            android:shadowDy="4"
                            android:shadowRadius="8"
                            android:text="100%"
                            android:textColor="@color/white"
                            android:textSize="48sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:elevation="5dp"
                            android:letterSpacing="0.2"
                            android:shadowDx="10"
                            android:shadowDy="10"
                            android:shadowRadius="10"
                            android:text="CAPACITY"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-black"
                            android:translationY="35dp" />

                        <ImageView
                            android:id="@+id/trendIndicator"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="50dp"
                            android:elevation="10dp"
                            android:src="@drawable/ic_trend_arrow"
                            android:visibility="invisible"
                            app:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/confettiContainer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_gravity="top"
                    android:elevation="20dp" />
            </FrameLayout>


                <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <FrameLayout
                android:id="@+id/usageCardContainer"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_duo_card"
                android:paddingBottom="4dp"> <!-- Padding for bottom border -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="left"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_rounded"
                            android:padding="8dp"
                            android:src="@drawable/ic_chart_bars"
                            app:tint="@color/duo_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="4dp"
                            android:text="Daily Usage"
                            android:textColor="@color/duo_text_primary"
                            android:textSize="24sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="Analysis for the current week"
                        android:textColor="@color/duo_text_secondary"
                        android:fontFamily="sans-serif-medium"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_border" />

                                <View
                                    android:id="@+id/mondayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_blue" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/monday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="M"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Repeating for other days -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_border" />

                                <View
                                    android:id="@+id/tuesdayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_blue" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tuesday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="T"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_border" />

                                <View
                                    android:id="@+id/wedBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_blue" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/wed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="W"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_border" />

                                <View
                                    android:id="@+id/thursdayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_blue" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/thursday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="T"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_border" />

                                <View
                                    android:id="@+id/fridayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_blue" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/friday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="F"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_border" />

                                <View
                                    android:id="@+id/saturdayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_blue" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/saturday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="S"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="160dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_border" />

                                <View
                                    android:id="@+id/sundayBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_bar_shape"
                                    android:backgroundTint="@color/duo_blue" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/sunday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="S"
                                android:textColor="@color/duo_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <LinearLayout
                    android:id="@+id/capacityCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_duo_card"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingTop="16dp" 
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/waterwaves"
                        app:tint="@color/duo_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="TOTAL LEFT"
                        android:layout_marginTop="8dp"
                        android:textAlignment="textStart"
                        android:textColor="@color/duo_text_secondary"
                        android:textSize="12dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/capacityValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1,300 L"
                        android:textAlignment="textStart"
                        android:textColor="@color/duo_text_primary"
                        android:textSize="20dp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/avgUsageCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_duo_card"
                    android:gravity="left"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/clock"
                        app:tint="@color/duo_orange" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-black"
                        android:text="DAILY AVG"
                        android:textAlignment="textStart"
                        android:textColor="@color/duo_text_secondary"
                        android:textSize="12dp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/dailyAvgValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 L"
                        android:textAlignment="center"
                        android:textColor="@color/duo_text_primary"
                        android:textSize="20dp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
