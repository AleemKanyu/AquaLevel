<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Mode Palette Overrides -->
    <color name="surface_background">#121212</color>
    <color name="surface_card">#1E1E1E</color>
    <color name="border_color">#333333</color>
    <color name="text_primary">#E0E0E0</color>
    <color name="text_secondary">#B0B0B0</color>

    <!-- Keep brand colors vibrant in dark mode -->
    <color name="brand_primary">#1CB0F6</color>
    <color name="brand_success">#78FF00</color>
    <color name="brand_warning">#FF9600</color>
    <color name="brand_info">#CE82FF</color>
    <color name="brand_accent">#2CDAC5</color>
    
    <!-- Legacy Mappings (Dark) -->
    <color name="duo_blue">@color/brand_primary</color>
    <color name="duo_blue_light">#303040</color> <!-- Darker blue tint for dark mode cards -->
    <color name="duo_blue_shadow">#1899D6</color>
    <color name="duo_green">@color/brand_success</color>
    <color name="duo_green_shadow">#5CB800</color>
    <color name="duo_orange">@color/brand_warning</color>
    <color name="duo_orange_shadow">#CC7900</color>
    <color name="duo_purple">@color/brand_info</color>
    <color name="duo_purple_shadow">#A560D1</color>
    <color name="duo_teal">@color/brand_accent</color>
    <color name="duo_teal_shadow">#1FA394</color>
    <color name="duo_border">@color/border_color</color>
    <color name="duo_card_bg">@color/surface_card</color>
    <color name="duo_card_shadow">#000000</color>
    <color name="duo_text_primary">@color/text_primary</color>
    <color name="duo_text_secondary">@color/text_secondary</color>

    <color name="background_light">@color/surface_background</color>
    <color name="background_dark">@color/surface_background</color>
    <color name="card_background_light">@color/duo_card_bg</color>
    <color name="card_background_dark">@color/duo_card_bg</color>
    <color name="text_primary_light">@color/duo_text_primary</color>
    <color name="text_primary_dark">@color/duo_text_primary</color>
    <color name="text_secondary_light">@color/duo_text_secondary</color>
    <color name="text_secondary_dark">@color/duo_text_secondary</color>

    <!-- Notification Card Colors (Dark Mode) -->
    <color name="notification_card_bg">#3E2723</color>
    <color name="notification_icon_tint">#FFB74D</color>
    <color name="notification_text_primary">#FFE0B2</color>
    <color name="notification_text_secondary">#FFCC80</color>
    <color name="notification_button_bg">#FFA726</color>
    <color name="notification_button_text">@android:color/black</color>
    
    <color name="main_background">@color/surface_background</color>
</resources>
