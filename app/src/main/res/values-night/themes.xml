<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AquaLevel_" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors (Can be tweaked for Dark Mode if needed, but linking to semantic names) -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/black</item> <!-- Adjusted for dark mode brand primary -->
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/brand_warning</item>

        <!-- Surface and Background (Overrides for Dark Mode) -->
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_background</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_color</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/text_primary</item>
    </style>
</resources>
