<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="60dp"
        android:bottomRightRadius="60dp" />
    <!-- Solid color removed to allow WaveView to draw it. 
         Wait, if we use this for clipping, we can leave solid color? 
         If clipToOutline is true, the shadow logic uses the abstract shape.
         But if resizing, the view might just draw background. 
         Let's keep it transparent if possible. -->
    <solid android:color="@android:color/transparent"/>
</shape>
