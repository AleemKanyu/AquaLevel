<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State (No shadow, button moves down) -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/duo_blue" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default State (Shadow visible) -->
    <item>
        <layer-list>
            <!-- Shadow Layer -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/duo_blue_shadow" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Top Button Layer -->
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/duo_blue" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
